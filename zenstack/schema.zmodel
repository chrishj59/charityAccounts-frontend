enum Role {
  MANAGER
  RECEIVABLE_POSTER
  PAYABLE_POSTER
  GL_POSTER
  RECEIVABLE_DISPLAY
  CLERK
  user
  member
  admin
  ORG_ADMIN
}

datasource db {
  provider = "postgresql"
  url      = env('DATABASE_URL')
  defaultSchema = 'charitatis'
}



plugin policy {
  provider = '@zenstackhq/plugin-policy'
}

plugin softDelete {
  provider = '@zenstackhq/plugin-soft-delete'
}





/// Shape of the `auth()` function
type Auth {
  userId           String  @id
  organizationId   String?
  organizationRoles String?
  role             String
  @@auth
}

enum OrgLegalForm {
  SoleTrader
  Company
  Partnership
}
enum OrgIdentificationType {
  UTR_tax_ref
  Company_Number
  Charity_number
}
enum OrgPlanType {
  Trial
  Free
  Standard
  Premium
}

enum PersonType {
  Person
  Organisation
}

enum FundType {
  General
  Designated
  Income
  Expendable
  Permanent
}



model TodoList {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  name           String
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId        String        @default(auth().userId) //@allow('update', false)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?       @default(auth().organizationId) //@allow('update', false)
  todos          Todo[]

  // deny anonymous users
  @@deny('all', auth() == null)

  // deny access to lists that don't belong to the user's active organization
  @@deny('all', auth().organizationId != organizationId)

  // users can create lists for themselves
  @@allow('create', auth().userId == ownerId)

  // full access to: list owner, org owner, and org admins
  @@allow('all', auth().userId == ownerId || auth().organizationRoles == 'owner' || auth().organizationRoles == 'admin')

  // if the list belongs to an org, it's readable to all members
  @@allow('read', organizationId != null)
}

model PostingPeriod {
  id             Int                    @id @default(autoincrement())
  year           Int
  period         Int
  open           Boolean
  postPeriod     CompanyPostingPeriod []

  organization   Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?                @default(auth().organizationId) //@allow('update', false)
  
  // deny anonymous users
  @@deny('all', auth() == null)

  // deny access to lists that don't belong to the user's active organization
  @@deny('all', auth().organizationId != organizationId)

  

  // if the list belongs to an org, it's readable to all members
  @@allow('read', organizationId != null)
}

model Todo {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String
  done      Boolean  @default(false)
  listId    String
  list      TodoList @relation(fields: [listId], references: [id], onDelete: Cascade)

  // full access if the parent TodoList is readable
  @@allow('all', check(list, 'read'))
}

model User {
  id                          String           @id @default(cuid())
  name                        String           @default('')
  displayName                 String           @length(1,  40, 'Display name is required up to 40 characters') @default('')
  firstName                   String           @length(1,  40, 'First name is required up to 40 characters') @default('')
  familyName                  String           @length(1,  40, 'Family name is required up to 40 characters') @default('')
  email                       String           @unique
  emailVerified               Boolean          @default(false)
  image                       String?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @default(now()) @updatedAt
  // role          String?
  role                        Role             @default(user)
  
  banned                      Boolean?
  banReason                   String?
  banExpires                  DateTime?
  sessions                    Session[]
  accounts                    Account[]
  members                     Member[]
  teamMembers                 TeamMember[]
  invitations                 Invitation[]
  todoLists                   TodoList[]
  apiKey                      Apikey?
  glaccounts                  GlAccount[]
  partners                    Partner[]
  fundsCreated                Fund[]                   @relation(name:'fundCreatedBy')
  fundsManaged                Fund[]                   @relation(name: 'fundManagedBy')
  designatedFund              DesignatedFund[]         @relation(name: 'designatedBy')
  createdDesignatedFund       DesignatedFund[]         @relation(name: "designationCreate")
  releasedDesignatedFund      DesignatedFund[]         @relation(name: 'designationRelease')
  fiscPeriodRuleCreated       FiscalPeriodRuleHeader[] @relation(name:'fiscPeriodRuleCreated')
  fiscPeriodRuleUpdated       FiscalPeriodRuleHeader[] @relation(name:'fiscPeriodRuleUpdated')
  fiscPeriodRuleLineCreated   FiscalPeriodRule[]   @relation(name:'fiscPeriodRuleLineCreated')
  fiscPeriodRuleLineUpdated   FiscalPeriodRule[]       @relation(name:'fiscPeriodRuleLineUpdated')
  coaCreated                  ChartOfAccounts[]        @relation(name:'coa_create')
  coaUpdate                   ChartOfAccounts[]        @relation(name:'coa_update')
  companiesCreated            Company[]              @relation(name:'companyCreatedBy')
  companiesUpdated            Company[]              @relation(name:'companyUpdatedBy')
  companyGroupsCreated        CompanyGroup[]          @relation(name: 'companyGroupCreatedBy')
  companyGroupsUpdated        CompanyGroup[]         @relation(name: 'companyGroupUpdatedBy')
  lastLoginMethod             String?
  organizationId              String?
  organization                Organization?            @relation(fields: [organizationId], references: [id])
  // @@allow('all', auth().organizationId == organizationId)

  @@allow('read', auth().organizationId == organizationId)
  @@allow('all', auth().userId == id)


  @@map("user")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @default(now()) @updatedAt

  @@map("verification")
}



model Organization {
  id             String                @id
  name           String
  slug           String                @unique
  logo           String?
  
  metadata       String?
  tradingName    String                @length(1,  50, "Must be between 1 and 50 characters")
  legalForm      OrgLegalForm          @default(SoleTrader)
  legalName      String                @length(1,  50, "Must be between 1 and 50 characters")
  charityNumber  String?
  taxRef         String?
  companyNumber  String?
  companyName    String?
  idType         OrgIdentificationType @default(UTR_tax_ref)
  identification String                @length(1,  50, "Must be between 1 and 50 characters")
  accountType    OrgPlanType           @default(Trial)
  members        Member[]
  postingPeriods PostingPeriod[]
  users           User[]
  invitations    Invitation[]
  todoLists      TodoList[]
  funds          Fund[]                @relation(name: 'fund')
  companies      Company[]             @relation(name: 'companyOrganisation')
  companyGroups   CompanyGroup[]      @relation(name: 'companyGroupOrg')
  periodRules    FiscalPeriodRuleHeader[]     @relation( 'orgPerionRuleHeader')
  fiscRulePeriods    FiscalPeriodRule[]        @relation('orgPerionRule')
  coaList        ChartOfAccounts[]     @relation('coaOrganisation')
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @default(now()) @updatedAt
  @@map('organization')
  
  // Only members of this org can read it
  @@allow('read', auth().organizationId == id)
}

model Team {
  id             String       @id
  name           String
  organizationId String
  teamMembers    TeamMember[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String

  createdAt      DateTime     @default(now())
  
  updatedAt       DateTime @updatedAt
  @@map("member")
  // @@allow('all', true)
  @@allow('all', auth().organizationRoles == 'admin')
}

model TeamMember {
  id        String   @id
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatesAt DateTime @default(now()) @updatedAt
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @email
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}




model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime
  updatedAt            DateTime
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  impersonatedBy       String?

  @@unique([token])
  @@map("session")
}






model ISOCountry {
  countryId   Int             @id @default(autoincrement())
  code2       String          @unique @length(1,  2, "Code must be length 2 char")
  code3       String          @unique @length(1,  3, "ISO address code3 must be 3 char length ")
  number      Int
  name        String
  description String
  addresses   Address[]
  regions     AddressRegion[]
  // global data
  @@allow('all', true)
}

model ISO4217Currency {
  id Int  @id @default(autoincrement()) 
  entity String
  currency String
  alphabeticCode String
  numericCode Int
  minorUnit String 
  withdrawalDate String?
  generalFund GeneralFund[] @relation(name: 'genFundCurr')
  designatedFund DesignatedFund[] @relation(name: 'designatedFundCurr')
  incomeFund IncomeFund[] @relation(name: 'incomeFundCurr')
  endownmentPermanent EndownmentPermanent[] @relation(name: 'endownmentPermanentCurr')
  endownmentExpendable EndownmentExpendable[]    @relation(name: 'endownmentExpendableCurr')
  fundBalance FundBalance[] @relation(name: 'fundBalanceCurr')
   @@index(fields: [currency], map: 'idx_ISO4217Currency_currency')
  @@allow('all', true)

}

model AddressRegion {
  regionId     Int        @id @default(autoincrement())
  isoCountryId Int
  country      ISOCountry @relation(fields: [isoCountryId], references: [countryId])
  name         String
}

model Address {
  addressID    Int        @id @default(autoincrement())
  buildingCode String?    @length(0,  10, 'building code can be up 10 characters')
  room         String?    @length(0,  10, 'room can be up 10 characters')
  careOf       String?    @length(0,  50, 'Care of be up 10 characters')
  street2      String?    @length(0,  50, 'Street2 can be up 10 characters')
  street3      String?    @length(0,  50, 'Street3 can be up 10 characters')
  houseNumber  Int?
  street       String     @length(1, 50, 'Street must be upto 50 char')
  town         String?    @length(0,  50, 'Town can be up 10 characters')
  county       String?    @length(0,  50, 'County can be up 10 characters')
  postCode     String?    @length(1,  10, 'Post code must be up 10 characters')
  isoCountryId Int
  country      ISOCountry @relation(fields: [isoCountryId], references: [countryId])
  partnerId    String
  partners     Partner[]
  // companyId String
  companys     Company?   @relation('registereOfficeAddress')
}





model Apikey {
  id                  String    @id
  name                String?
  start               String?
  prefix              String?
  key                 String
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int?
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@map("apikey")
}

model GlAccount {
  id             String        @id @default(uuid())
  name           String
  balanceSheet   Boolean
  reportCat      String
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id])
  ArApRecAccount ArAPPartner[]
}

model Partner {
  id          String     @id @default(uuid())
  name        String     @length(1,  40, 'Partner name is requiredd')
  personType  PersonType
  familyName  String?
  addressId   Int
  searchTerm  String     @length(1,  20, 'Search term to find partners')
  stripeId    String
  address     Address    @relation(fields: [addressId], references: [addressID])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  type        String     @length(1,  20, 'Type of partner')


  @@delegate(type)
}

model ArAPPartner extends Partner {
  reconAccountId String
  reconAccount   GlAccount @relation(fields: [reconAccountId], references: [id])
  companyId      String
  //  company          Team      @relation(fields: [companyId], references: [id])
}

model FiscalPeriodRuleHeader {
  id              Int                 @id @default(autoincrement())
  title           String
  calendarBased   Boolean             @default(false)
  rulePeriods     FiscalPeriodRule[]  @relation(name:'period-rule-header')
  createdAt       DateTime            @default(now())
  updatedAt       DateTime?           @default(now()) @updatedAt
  createdById     String    
  createdBy       User                @relation('fiscPeriodRuleCreated',fields: [createdById], references: [id])
  updatedById     String?
  updatedBy       User?               @relation('fiscPeriodRuleUpdated',fields: [updatedById], references: [id])
  organizationId  String
  groupCompanies  CompanyGroup[]      @relation('fiscPerRuleCompGroup')
  coa             ChartOfAccounts[]   @relation('fiscPeriodRuleHeader')
  organization    Organization?       @relation('orgPerionRuleHeader',fields: [organizationId], references: [id])
  deletedAt       DateTime?           @deletedAt
  @@allow('all', auth().organizationId == organizationId)
}
model FiscalPeriodRule {
  id              Int       @id @default(autoincrement())
  
  periodName      String
  periodNum       Int     
  day             Int
  fiscPeriod      Int
  headerId        Int
  header          FiscalPeriodRuleHeader @relation('period-rule-header',fields: [headerId], references: [id])
  
  yearShift       Boolean
  
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime?   @default(now()) @updatedAt
  createdById     String    
  createdBy       User       @relation('fiscPeriodRuleLineCreated',fields: [createdById], references: [id])
  updatedById     String?
  updatedBy       User?       @relation('fiscPeriodRuleLineUpdated',fields: [updatedById], references: [id])
  deletedAt       DateTime?   @deletedAt
  organizationId  String
  organization    Organization? @relation('orgPerionRule',fields: [organizationId], references: [id])
  

  @@allow('all', auth().organizationId == organizationId)
  
  
  // deny anonymous users
  //  @@deny('all', auth() == null)
}



model Parameter {
  id    Int    @id @default(autoincrement())
  name  String
  value String

  @@allow('create,read', true)
}

model ChartOfAccounts {
  id                        Int           @id @default(autoincrement())
  name                      String        @unique
  companies                 Company[]     @relation(name:'chartOfAccounts')
  organizationId             String
  organization              Organization  @relation('coaOrganisation', fields:[organizationId], references: [id])
  fiscalPeriodRuleId        Int
  fiscPeriodRule            FiscalPeriodRuleHeader @relation('fiscPeriodRuleHeader', fields: [fiscalPeriodRuleId], references: [id])
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @default(now()) @updatedAt
  createdById               String
  createdBy                 User       @relation('coa_create',fields: [createdById], references: [id])
  updatedById               String?
  updatedBy                 User?       @relation('coa_update',fields: [updatedById], references: [id])        
  @@allow('all', auth().organizationId == organizationId)
@@map('Coa')
}

model CompanyGroup {
  id                Int       @id @default(autoincrement())
  name              String
  fiscalPeriodRuleId        Int
  fiscPeriodRule            FiscalPeriodRuleHeader @relation('fiscPerRuleCompGroup', fields: [fiscalPeriodRuleId], references: [id])
  companies         Company[] @relation('companyGroup')
  organizationId             String
  organization              Organization            @relation('companyGroupOrg', fields:[organizationId], references: [id])
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @default(now()) @updatedAt
  createdById               String
  createdBy                 User       @relation('companyGroupCreatedBy',fields: [createdById], references: [id])
  updatedById               String?
  updatedBy                 User?   @relation('companyGroupUpdatedBy',fields: [updatedById], references: [id])
  // @@allow('all',true)
  @@allow('all', auth().organizationId == organizationId)

}

model Company {
  id                        Int                    @id @default(autoincrement())
  companyCode               String
  companyName               String
  registeredOfficeAddressId Int                    @unique
  regsisteredAddress        Address                @relation('registereOfficeAddress',  fields: [registeredOfficeAddressId], references: [addressID])
  vatNumber                 String?
  
  postPeriod                CompanyPostingPeriod []
  organizationId             String
  organization              Organization            @relation('companyOrganisation', fields:[organizationId], references: [id])
  chartOfAccountsId         Int
  ChartOfAccounts           ChartOfAccounts       @relation('chartOfAccounts',fields: [chartOfAccountsId], references: [id])
  companyGroupId            Int
  companyGroup              CompanyGroup          @relation('companyGroup',fields: [companyGroupId], references: [id])         
  
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @default(now()) @updatedAt
  createdById               String
  createdBy                 User       @relation('companyCreatedBy',fields: [createdById], references: [id])
  updatedById               String?
  updatedBy                 User?   @relation('companyUpdatedBy',fields: [updatedById], references: [id])
  @@allow('all', auth().organizationId == organizationId)
}



model CompanyPostingPeriod {
  companyId       Int
  postingPeriodId Int
  company         Company       @relation(fields: [companyId], references: [id])
  postPeriod      PostingPeriod @relation(fields: [postingPeriodId], references: [id])
  @@id([companyId,postingPeriodId ])

}

model Fund {
  id             String       @id @default(uuid())
  updatedAt      DateTime     @default(now()) @updatedAt
  createdAt      DateTime     @default(now())
  fundName       String
  donarName      String?
  objective      String?
  
  organizationId String       @default('')
  teamId         String       @default('') 
  organization   Organization @relation(name: 'fund',  fields: [organizationId], references: [id], onDelete: Cascade)
  createdById       String
  createdBy      User         @relation('fundCreatedBy',fields: [createdById], references: [id])
  managedById    String
  managedBy      User         @relation('fundManagedBy',fields: [managedById], references: [id])
  fundType       String       @default('General')
  reviewDate     DateTime?
  type           String

  @@delegate(type)
  //restricted by organisation

  @@allow('all', auth().organizationId == organizationId)
  
  
}

model GeneralFund extends Fund {

  balance  Int      @db.Integer @default(0)
  curcyCode String  @default('') @db.Char(3)
  balances FundBalance[] @relation( name: 'genFundBal')
  currencyId  Int
  currency ISO4217Currency @relation(name: 'genFundCurr',fields: [currencyId], references: [id])
  @@allow('all', auth().organizationId == organizationId)
  

}

model RestrictedFund extends Fund {
  projectEndDate      DateTime
  restrictedType      String
  nextDonarReviewDate DateTime?
  returnSurplus       Boolean?
  @@allow('all', auth().organizationId == organizationId)
  @@delegate(restrictedType)
}
model DesignatedFund extends RestrictedFund {
  designatedBal   Int      @db.Integer @default(0)
  curcyCode String   @default('') @db.Char(3)
  currentBal Int      @db.Integer @default(0)
  
  designatedDate          DateTime
  releasedDate            DateTime?
  designatedById          String
  designatedMeeting       String @default('')
  undesignateMeeting      String?
  designationReleasedById String?
  designationCreatedById  String
  designatedBy            User?         @relation(name: 'designatedBy', fields: [designatedById], references: [id])
  designationCreatedBy    User          @relation(name: 'designationCreate', fields: [designationCreatedById], references: [id])
  designationReleasedBy   User?         @relation(name: 'designationRelease', fields: [designationReleasedById], references: [id])
  currencyId  Int
  currency ISO4217Currency @relation(name: 'designatedFundCurr',fields: [currencyId], references: [id])
  balances                FundBalance [] @relation('designatedBal')
  @@allow('all', auth().organizationId == organizationId)
}

model IncomeFund extends RestrictedFund {
  balance  Int      @db.Integer @default(0)
  curcyCode String   @default('') @db.Char(3)
  balances FundBalance[] @relation('incomeFundBal')
  currencyId  Int
  currency ISO4217Currency @relation(name: 'incomeFundCurr',fields: [currencyId], references: [id])
  @@allow('all', auth().organizationId == organizationId)
}

model EndownmentPermanent extends RestrictedFund {
  initalCapital      Int      @db.Integer @default(0)
  incomeEarned       Int      @db.Integer @default(0)
  incomeBalance      Int      @db.Integer @default(0)
  capitalBalance     Int      @db.Integer @default(0)
  
  permanentIncomeBalances  FundBalance[] @relation('permanentIncomeFundBal')
  permanentCapitalBalances FundBalance[] @relation('permanentCapitalFundBal')
  
  curcyCode          String   @default('') @db.Char(3)
  currencyId         Int
  currency           ISO4217Currency @relation(name: 'endownmentPermanentCurr',fields: [currencyId], references: [id])
  @@allow('all', auth().organizationId == organizationId)
}

model EndownmentExpendable extends RestrictedFund {
  initalCapital       Int      @db.Integer @default(0)
  incomeEarned        Int      @db.Integer @default(0)
  incomeBalance       Int      @db.Integer @default(0)
  capitalBalance      Int      @db.Integer @default(0)
  
  expendableIncomeBalances  FundBalance[] @relation('expendableIncomeFundBal')
  expendableCapitalBalances FundBalance[] @relation('expendableCapitalFundBal')
  curcyCode String   @default('') @db.Char(3)
  currencyId  Int
  currency ISO4217Currency @relation(name: 'endownmentExpendableCurr',fields: [currencyId], references: [id])
  @@allow('all', auth().organizationId == organizationId)
}

model FundBalance {
  id                      String                @id @default(uuid())
  fiscalPeriod            Int
  fiscalYear              Int
  balance                 Int      @db.Integer @default(0)
  curcyCode String   @default('') @db.Char(3)
  currencyId  Int
  currency ISO4217Currency @relation(name: 'fundBalanceCurr',fields: [currencyId], references: [id])
  generalFundId           String?
  generalFund             GeneralFund?          @relation(name: 'genFundBal',  fields: [generalFundId], references: [id])

  incomeFundId            String?
  incomeFund              IncomeFund?           @relation(name: 'incomeFundBal',  fields: [incomeFundId], references: [id])
  designiatedFundId       String?
  designatedfund          DesignatedFund?       @relation(name: 'designatedBal',  fields: [designiatedFundId], references: [id])
  expendableIncomeFundId  String?
  expendableIncomefund    EndownmentExpendable? @relation(name: 'expendableIncomeFundBal',  fields: [expendableIncomeFundId], references: [id])
  expendableCapitalFundId String?
  expendableCapitalfund   EndownmentExpendable? @relation(name: 'expendableCapitalFundBal',  fields: [expendableCapitalFundId], references: [id])
  permanentIncomeFundId   String?
  permanentIncomefund     EndownmentPermanent?  @relation(name: 'permanentIncomeFundBal',  fields: [permanentIncomeFundId], references: [id])
  permanentCapitalFundId  String?
  permanentCapitalfund    EndownmentPermanent?  @relation(name: 'permanentCapitalFundBal',  fields: [permanentCapitalFundId], references: [id])
}

model JournalDoc {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ref          String
  year         Int
  fiscalPeriod Int
  headerText   String

  @@allow('create', auth().role in [RECEIVABLE_POSTER, PAYABLE_POSTER, GL_POSTER])
}



