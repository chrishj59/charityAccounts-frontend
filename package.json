  "scripts": {
    "db:generate": "zen generate --lite",
    "db:push": "zen db push",
    "auth:generate": "pnpm dlx @better-auth/cli@1.4.21 generate",
    "auth:migrate": "pnpm dlx @better-auth/cli@1.4.21 migrate",
    "db:migrate": "zen migrate dev",
    "db:deploy": "zen migrate deploy",
    "db:reset": "zen migrate reset",
    "dev": "next dev",
    "dev:secure": "next dev --experimental-https",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write \"{app,demo,layout,types}/**/*.{js,ts,tsx,d.ts}\"",
    "lint": "next lint",
    "up": "pnpm add @zenstackhq/cli@latest @zenstackhq/better-auth @zenstackhq/orm@latest @zenstackhq/schema @zenstackhq/server@latest @zenstackhq/tanstack-query@latest @zenstackhq/plugin-policy@latest"
