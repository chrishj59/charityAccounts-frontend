 enum Role {
  MANAGER
  RECEIVABLE_POSTER
  PAYABLE_POSTER
  GL_POSTER
  RECEIVABLE_DISPLAY
 }

datasource db {
  provider = "postgresql"
  url      = env('DATABASE_URL')
  defaultSchema = 'charitatis'
}



plugin policy {
    provider = '@zenstackhq/plugin-policy'
}

plugin hooks {
  provider = "@zenstackhq/tanstack-query"
  target = "react"
  output = "./hooks/model"
}


/// Shape of the `auth()` function
type Auth {
  userId           String  @id
  organizationId   String?
  organizationRole String?
  role             String
  @@auth
}

enum OrgLegalForm{
    SoleTrader
    Company
    Partnership
    }
enum OrgIdentificationType {
  UTR_tax_ref
  Company_Number
  Charity_number
}
 enum OrgPlanType {
  Trial
  Free
  Standard
  Premium
 }

 enum PersonType {
  Person
  Organisation

 }

model TodoList {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  name           String
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId        String        @default(auth().userId) //@allow('update', false)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?       @default(auth().organizationId) //@allow('update', false)
  todos          Todo[]

  // deny anonymous users
  @@deny('all', auth() == null)

  // deny access to lists that don't belong to the user's active organization
  @@deny('all', auth().organizationId != organizationId)

  // users can create lists for themselves
  @@allow('create', auth().userId == ownerId)

  // full access to: list owner, org owner, and org admins
  @@allow('all', auth().userId == ownerId || auth().organizationRole == 'owner' || auth().organizationRole == 'admin')

  // if the list belongs to an org, it's readable to all members
  @@allow('read', organizationId != null)
}

model PostingPeriod {
  id      Int @id @default(autoincrement())
  year    Int
  period  Int
  open    Boolean 
  postPeriod CompanyPostingPeriod []
  
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?       @default(auth().organizationId) //@allow('update', false)
  
  // deny anonymous users
  @@deny('all', auth() == null)

  // deny access to lists that don't belong to the user's active organization
  @@deny('all', auth().organizationId != organizationId)

  

  // if the list belongs to an org, it's readable to all members
  @@allow('read', organizationId != null)
 }

model Todo {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String
  done      Boolean  @default(false)
  listId    String
  list      TodoList @relation(fields: [listId], references: [id], onDelete: Cascade)

  // full access if the parent TodoList is readable
  @@allow('all', check(list, 'read'))
}

model User {
  id            String        @id @default(cuid())
  name          String        @default('')
  displayName   String        @length(1,40,'Display name is required up to 40 characters') @default('')
  firstName     String        @length(1,40,'First name is required up to 40 characters') @default('')
  familyName    String        @length(1,40,'Family name is required up to 40 characters') @default('')
  email         String        @unique    
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  // role          String?
  role          Role
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  teamMembers   TeamMember[]
  invitations   Invitation[]
  todoLists     TodoList[]
  apiKey        Apikey?
  glaccounts    GlAccount[]
  partners      Partner[]
  funds         Fund[]
  lastLoginMethod String?
  

  
  @@map("user")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String     @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?  @default(now())
  updatedAt  DateTime?  @default(now()) @updatedAt

  @@map("verification")
}



model Organization {
    id             String       @id
    name           String
    slug           String       @unique
    logo           String?
    createdAt           DateTime
    metadata            String?
    tradingName         String       @length(1,50, "Must be between 1 and 50 characters")
    legalForm           OrgLegalForm    @default(SoleTrader)
    legalName           String       @length(1,50, "Must be between 1 and 50 characters")
    charityNumber       String?
    taxRef              String?
    companyNumber       String?
    companyName         String?
    idType OrgIdentificationType     @default(UTR_tax_ref)
    identification      String       @length(1,50, "Must be between 1 and 50 characters")
    accountType         OrgPlanType  @default(Trial)
    members             Member[]
    postingPeriods      PostingPeriod[]
    
    invitations         Invitation[]
    todoLists           TodoList[]

    @@map('organization')
}

model Team {
  id              String        @id
  name            String
  organizationId	String
  teamMembers    TeamMember[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  
  createdAt      DateTime     @default(now())
  updatesAt      DateTime     @default(now()) @updatedAt

  @@map("member")
}

model TeamMember {
  id            String @id
  teamId        String
  team          Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId        String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatesAt      DateTime     @default(now()) @updatedAt
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @email
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}




model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime
  updatedAt            DateTime
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  impersonatedBy       String?

  @@unique([token])
  @@map("session")
}






model ISOCountry {
  countryId Int @id @default(autoincrement())
  code2 String  @unique @length(1,2,"Code must be length 2 char")
  code3 String  @unique @length(1,3, "ISO address code3 must be 3 char length ")
  number Int
  name String
  description String
  addresses Address[]
  regions AddressRegion[]
  

  
}
 model AddressRegion {
  regionId Int @id @default(autoincrement())
  isoCountryId Int
  country ISOCountry @relation(fields: [isoCountryId], references: [countryId])
  name String
  
 }

model Address {
  addressID Int         @id @default(autoincrement())
  buildingCode String?  @length(0,10, 'building code can be up 10 characters' )
  room String?          @length(0,10, 'room can be up 10 characters' )
  careOf String?        @length(0,50, 'Care of be up 10 characters' )
  street2 String?       @length(0,50, 'Street2 can be up 10 characters' )
  street3 String?       @length(0,50, 'Street3 can be up 10 characters' )
  houseNumber Int?      
  street String         @length(1, 50, 'Street must be upto 50 char')
  town String?          @length(0,50, 'Town can be up 10 characters' )
  county String?        @length(0,50, 'County can be up 10 characters' )
  postCode String?      @length(1,10, 'Post code must be up 10 characters' )
  isoCountryId Int
  country ISOCountry    @relation(fields: [isoCountryId], references: [countryId])
  partnerId    String
  partners Partner[]
  // companyId String
  companys Company?   @relation('registereOfficeAddress')
  
  


}





model Apikey {
  id                  String    @id
  name                String?
  start               String?
  prefix              String?
  key                 String
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int?
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@map("apikey")
}
 
 model GlAccount {
  id              String @id @default(uuid())
  name            String
  balanceSheet    Boolean
  reportCat       String
  createdById     String
  createdBy       User @relation(fields: [createdById], references: [id])
  ArApRecAccount  ArAPPartner[]

 }

 model Partner {
  id          String    @id @default(uuid())
  name        String    @length(1,40, 'Partner name is requiredd')
  personType  PersonType
  familyName  String? 
  addressId   Int
  searchTerm  String    @length( 1,20, 'Search term to find partners')
  stripeId    String
  address     Address   @relation(fields: [addressId], references: [addressID])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  type        String    @length(1,20, 'Type of partner')


  @@delegate(type)

 }

 model ArAPPartner extends Partner{
   reconAccountId   String
   reconAccount     GlAccount @relation(fields: [reconAccountId], references: [id])
   companyId        String
  //  company          Team      @relation(fields: [companyId], references: [id])
 }

 model FiscalPeriodRule {
  id            Int @id @default(autoincrement())
  name          String
  monthNum      Int
  day           Int
  fiscPeriod    Int
  yearShift     Boolean
  calendarBased Boolean
  companies     Company[] @relation('fiscPeriodRule')
  @@allow('all', true)
  @@allow('all', auth().organizationRole == 'admin')
  // deny anonymous users
  // @@deny('all', auth() == null)

 }

 

 model Parameter {
  id Int  @id @default(autoincrement())
  name String
  value String

  @@allow('create,read', true)
 }

 model Company {
  id Int @id @default(autoincrement())
  companyCode String
  companyName String
  registeredOfficeAddressId Int @unique
  regsisteredAddress Address @relation('registereOfficeAddress',fields: [registeredOfficeAddressId], references: [addressID])
  vatNumber String?
  fiscalPeriodRuleId Int
  fiscPeriodRule FiscalPeriodRule @relation('fiscPeriodRule', fields: [fiscalPeriodRuleId], references: [id])
  postPeriod CompanyPostingPeriod []
 }



 model CompanyPostingPeriod {
  companyId Int
  postingPeriodId Int
  company Company @relation(fields: [companyId], references: [id])
  postPeriod PostingPeriod @relation(fields: [postingPeriodId], references: [id])
  @@id([companyId,postingPeriodId ])
 }

 model Fund {
  id String @id @default(uuid())
  updatedAt       DateTime      @default(now()) @updatedAt
  createdAt   DateTime  @default(now())
  fundName String
  donarName String?
  objective String?
  managedById String
  createdBy   User      @relation(fields: [managedById], references: [id])
  type      String

  @@delegate(type)

 }

 model UnrestrictedFund extends Fund {
  reviewDate DateTime?


 }

 model JournalDoc {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ref String
  year Int
  fiscalPeriod Int
  headerText String

  @@allow('create', auth().role in [RECEIVABLE_POSTER, PAYABLE_POSTER, GL_POSTER])


 }



